system:
  host: 0.0.0.0
  port: 16181
  http_client_timeout: 30
  web_ui: true
  detail_concurrency: 10
captcha:
  enable: true
  save_failed_img: false
  save_failed_img_path: faile_captcha
  retry_times: 2
  max_per_token: 40  # 每次打码后查40条(优化后黄金窗口，目标95%+成功率)
  queries_per_ip: 40  # 优化后: 40条/批 + 子批次10条 + IP被限换IP重查
proxy:
  local_ipv6_pool:
    enable: true
    pool_num: 100
    check_interval: 1
    ipv6_network_card: 以太网
  tunnel:
    url: null
  extra_api:
    url: null
    extra_interval: 3
    timeout: 100
    timeout_drop: 8
    check_proxy: true
    proxy_timeout: 0.5
    check_proxy_num: 20
    auto_maintenace: true
    pool_num: 100
risk_avoidance:
  allow_type:
  - web
  - app
  - mapp
  - kapp
  - bweb
  - bapp
  - bmapp
  - bkapp
  prohibit_suffix: []
log:
  dir: logs
  file_head: ymicp
  backup_count: 7
  save_log: true
  output_console: true
history:
  save_query_history: true
auth:
  enable: false
  secret: change-me
  session_hours: 72
  users:
  - username: admin
    password: sha256$240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
mcp:
  enable: false
  port: 16182
