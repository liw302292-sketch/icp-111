system:
  host: 0.0.0.0
  port: 16181
  http_client_timeout: 30
  web_ui: true
  detail_concurrency: 10
  batch_workers: 32  # 双前缀满编
  ip_query_concurrency: 3  # 每IP分片并发3路（实测4路更慢）
  ip_query_interval: 0.5  # 同一IP查询发送间隔（秒，实测0.5s安全）
  token_query_cap: 60  # 每个IP独立token窗口内最多查询条数
  ip_queries_per_rotation: 20  # 同一IP窗口内查询条数后轮换（实测20最优：59q/s vs 90=50q/s）
  max_requeue_attempts: 10  # 单个域名被限流后的最大延迟重试次数（指数退避）
  enable_stream_batch: true  # 多IP流式批量（共享token窗口 + 多IP轮换，429自动换IP）
  max_batch_size: 1000000  # 单次批量任务最大条数上限，超出会提示 batch size exceeds
captcha:
  enable: true
  save_failed_img: false
  save_failed_img_path: faile_captcha
  retry_times: 2
  max_per_token: 100  # per-captcha query window (实测单token窗口≈100条)
  queries_per_ip: 20  # 每个worker每批拉取域名数（进度上报粒度，token复用由rotation=90控制）
proxy:
  local_ipv6_pool:
    enable: true
    pool_num: 600  # 双前缀满编：约300家宽 + 300手机，两个独立窗口同时出量
    check_interval: 1
    ipv6_network_card: 以太网
  tunnel:
    url: null
  extra_api:
    url: null
    extra_interval: 3
    timeout: 100
    timeout_drop: 8
    check_proxy: true
    proxy_timeout: 0.5
    check_proxy_num: 20
    auto_maintenace: true
    pool_num: 100
risk_avoidance:
  allow_type:
  - web
  - app
  - mapp
  - kapp
  - bweb
  - bapp
  - bmapp
  - bkapp
  prohibit_suffix: []
log:
  dir: logs
  file_head: ymicp
  backup_count: 7
  save_log: true
  output_console: true
history:
  save_query_history: true
auth:
  enable: false
  secret: change-me
  session_hours: 72
  users:
  - username: admin
    password: sha256$240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
mcp:
  enable: false
  port: 16182






